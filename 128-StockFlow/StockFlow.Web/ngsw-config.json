{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    { "name": "app", "installMode": "prefetch", "resources": { "files": ["/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/favicon.ico"] } },
    { "name": "assets", "installMode": "lazy", "updateMode": "prefetch", "resources": { "files": ["/icons/**", "/assets/**"] } }
  ],
  "dataGroups": [],
  "navigationUrls": ["/**", "!/**/*.*", "!/api", "!/api/**"]
}
