<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- AI / LLM integration via Semantic Kernel (same pattern as 119-RAG-Pipeline) -->
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />
    <!-- Roslyn compiler for in-process C# execution -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
    <!-- Process isolation (Docker SDK) -->
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>
</Project>
